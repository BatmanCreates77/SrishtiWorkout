ch":"How much do you usually sleep?","options":[{"value":5,"label":"5 h or less"},{"value":6,"label":"About 6 h"},{"value":7,"label":"About 7 h"},{"value":8,"label":"8 h or more"}],"stage":"later","optional":true},{"id":"sleep_quality","section":"recovery","kind":"scale","field":"sleepQuality","low":"Restless","high":"Deep","coach":"And how well do you sleep?","stage":"later","optional":true},{"id":"stress","section":"recovery","kind":"scale","field":"stress","low":"Calm","high":"Very stressed","coach":"Stress lately?","stage":"later","optional":true},{"id":"energy","section":"recovery","kind":"scale","field":"energy","low":"Drained","high":"Energetic","coach":"Day-to-day energy?","stage":"later","optional":true},{"id":"cycle","section":"recovery","kind":"single","when":{"q":"sex","eq":"female"},"coach":"Does your menstrual cycle affect how you feel when training?","options":[{"value":"no","label":"Not really"},{"value":"some","label":"A few low days a month"},{"value":"a_lot","label":"Cramps / fatigue hit hard"},{"value":"na","label":"Not applicable"}],"react":{"a_lot":"Thanks. On those days, tell me and I'll swap in a lighter session. No guilt needed."},"stage":"later","optional":true},{"id":"diet","section":"nutrition","kind":"single","field":"dietPattern","coach":"Last section, food. How do you eat?","options":[{"value":"vegetarian","label":"Vegetarian"},{"value":"eggetarian","label":"Eggetarian"},{"value":"non_vegetarian","label":"Non-veg"},{"value":"pescatarian","label":"Pescatarian"},{"value":"vegan","label":"Vegan"}],"stage":"later","optional":true},{"id":"meals","section":"nutrition","kind":"single","field":"mealsPerDay","coach":"How many times a day do you eat, snacks included?","options":[{"value":2,"label":"2"},{"value":3,"label":"3"},{"value":4,"label":"4"},{"value":5,"label":"5+"}],"stage":"later","optional":true},{"id":"protein","section":"nutrition","kind":"single","field":"proteinPalms","coach":"How many palm-sized protein portions do you eat a day? One palm is about 100 g paneer, chicken or tofu, 2 eggs, a big bowl of curd, or a scoop of whey.","options":[{"value":1,"label":"0-1"},{"value":2,"label":"2"},{"value":3,"label":"3"},{"value":4,"label":"4+"}],"stage":"later","optional":true},{"id":"veg","section":"nutrition","kind":"single","field":"vegServings","coach":"Cups of vegetables a day?","options":[{"value":1,"label":"0-1"},{"value":2,"label":"2"},{"value":3,"label":"3"},{"value":4,"label":"4+"}],"stage":"later","optional":true},{"id":"fruit","section":"nutrition","kind":"single","field":"fruitServings","coach":"Fruit servings a day?","options":[{"value":0,"label":"0"},{"value":1,"label":"1"},{"value":2,"label":"2"},{"value":3,"label":"3+"}],"stage":"later","optional":true},{"id":"water","section":"nutrition","kind":"single","field":"waterLiters","coach":"Water a day?","options":[{"value":1,"label":"About 1 L"},{"value":1.5,"label":"1.5 L"},{"value":2,"label":"2 L"},{"value":3,"label":"3 L+"}],"stage":"later","optional":true},{"id":"sugary","section":"nutrition","kind":"single","field":"sugaryDrinksPerWeek","coach":"Sweet drinks per week (soda, juice, sweet chai or coffee)?","options":[{"value":0,"label":"None"},{"value":3,"label":"1-3"},{"value":7,"label":"About daily"},{"value":14,"label":"More than daily"}],"stage":"later","optional":true},{"id":"fried","section":"nutrition","kind":"single","field":"friedOrPackagedPerWeek","coach":"Fried or packaged snacks per week?","options":[{"value":1,"label":"Rarely"},{"value":3,"label":"2-4 times"},{"value":7,"label":"Most days"}],"stage":"later","optional":true},{"id":"alcohol","section":"nutrition","kind":"single","field":"alcoholPerWeek","coach":"Alcoholic drinks per week?","options":[{"value":0,"label":"None"},{"value":2,"label":"1-3"},{"value":6,"label":"4-7"},{"value":10,"label":"More"}],"stage":"later","optional":true},{"id":"late_eating","section":"nutrition","kind":"single","field":"lateEating","coach":"Is dinner usually within 2 hours of bedtime?","opti