{"questions":{"sections":[{"id":"welcome","title":"Welcome"},{"id":"you","title":"About you"},{"id":"health","title":"Health check"},{"id":"experience","title":"Experience"},{"id":"goals","title":"Goals"},{"id":"schedule","title":"Your week"},{"id":"preferences","title":"What you enjoy"},{"id":"recovery","title":"Recovery"},{"id":"nutrition","title":"Nutrition"}],"questions":[{"id":"intro","section":"welcome","kind":"info","coach":"Hi, I'm Maya, your coach. I'll ask you a few questions, then we'll do a short movement check together so I can build a plan around the real you. It takes about 20 minutes. You can tap an option or type your own answer anytime.","stage":"essentials"},{"id":"name","section":"you","kind":"text","field":"name","required":true,"coach":"First, what should I call you?","stage":"essentials"},{"id":"age","section":"you","kind":"number","field":"age","unit":"years","min":14,"max":90,"required":true,"coach":"Nice to meet you, {name}! How old are you? I use it to compare your results with the right norms.","stage":"essentials"},{"id":"sex","section":"you","kind":"single","field":"sex","required":true,"coach":"Which norms should I use for your fitness tests?","options":[{"value":"female","label":"Female"},{"value":"male","label":"Male"}],"stage":"essentials"},{"id":"parq","section":"health","kind":"multi","field":"parq","required":true,"coach":"Safety first. Do any of these apply to you?","options":[{"value":"none","label":"None of these","exclusive":true},{"value":"heart","label":"Heart condition or high blood pressure"},{"value":"chestPain","label":"Chest pain at rest or when active"},{"value":"dizzy","label":"Dizziness or fainting in the last year"},{"value":"chronic","label":"Another chronic condition (e.g. diabetes, thyroid, PCOS)"},{"value":"meds","label":"Prescribed medicine for a chronic condition"},{"value":"joint","label":"A joint or bone problem that activity could worsen"},{"value":"supervised","label":"A doctor said to exercise only under supervision"}],"react":{"any_except:none":"Thanks for telling me. I'll keep things conservative, and please check with your doctor before the harder efforts."},"stage":"essentials"},{"id":"cleared","section":"health","kind":"single","when":{"q":"parq","anyExcept":"none"},"coach":"Has a doctor cleared you for exercise since then?","options":[{"value":"yes","label":"Yes, I'm cleared"},{"value":"no","label":"Not yet"},{"value":"na","label":"Never asked"}],"stage":"essentials"},{"id":"pregnancy","section":"health","kind":"single","field":"pregnancy","when":{"q":"sex","eq":"female"},"coach":"Are you currently pregnant or have you had a baby recently?","options":[{"value":"no","label":"Neither"},{"value":"pregnant","label":"I'm pregnant"},{"value":"postpartum_lt12w","label":"Baby in the last 12 weeks"},{"value":"postpartum_gt12w","label":"Baby more than 12 weeks ago"}],"stage":"essentials"},{"id":"pelvic","section":"health","kind":"single","when":{"q":"sex","eq":"female"},"coach":"This one is common and nothing to be shy about: any leaking, heaviness or pelvic pain when you cough, jump, run or lift?","options":[{"value":"no","label":"No"},{"value":"sometimes","label":"Sometimes"},{"value":"often","label":"Yes, often"}],"react":{"sometimes":"Good to know. I'll skip jumping for now and add core work that supports your pelvic floor. A pelvic-floor physio is worth a visit.","often":"Thank you for sharing. I'll keep everything low-impact, and I'd really recommend seeing a pelvic-floor physio."},"stage":"essentials"},{"id":"pain","section":"health","kind":"multi","field":"painAreas","probe":true,"coach":"Any pain right now, or when you move or exercise?","options":[{"value":"none","label":"No pain","exclusive":true},{"value":"knee","label":"Knee"},{"value":"lower back","label":"Lower back"},{"value":"shoulder","label":"Shoulder"},{"value":"wrist","label":"Wrist / elbow"},{"value":"hip","label":"Hip"},{"value":"ankle","label":"Ankle / foot"},{"value":"neck","label":"Neck"}],"st