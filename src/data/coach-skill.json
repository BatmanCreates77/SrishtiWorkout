,{"id":"training_age","section":"experience","kind":"single","field":"trainingAge","required":true,"coach":"How would you describe your strength-training experience?","options":[{"value":0,"label":"None yet"},{"value":1,"label":"A little (under 6 months)"},{"value":2,"label":"6 months to 2 years"},{"value":3,"label":"More than 2 years"}],"stage":"essentials"},{"id":"fitness_level","section":"experience","kind":"single","coach":"And how fit do you feel right now, honestly?","options":[{"value":"starting","label":"Just getting started"},{"value":"somewhat","label":"Somewhat active"},{"value":"fit","label":"Fairly fit"},{"value":"very_fit","label":"Very fit"}],"stage":"essentials"},{"id":"test_liked","section":"goals","kind":"multi","coach":"Nice work on the movement check, {name}! Which of those moves did you actually enjoy?","options":[{"value":"squat","label":"Squat"},{"value":"push","label":"Push-up"},{"value":"row","label":"Row"},{"value":"hinge","label":"Glute bridge"},{"value":"lunge","label":"Lunge"},{"value":"plank","label":"Plank"},{"value":"none","label":"Honestly, none of them","exclusive":true}],"stage":"after_test"},{"id":"intensity_pref","section":"goals","kind":"single","coach":"How did that effort feel overall, and how hard do you want your workouts to be?","options":[{"value":"gentle","label":"That was plenty, start me gently"},{"value":"moderate","label":"About right, keep it moderate"},{"value":"challenging","label":"I could do more, challenge me"}],"probe":true,"stage":"after_test"},{"id":"fat_loss_target","section":"goals","kind":"single","when":{"q":"goal","eq":"fat_loss"},"coach":"How much would you like to lose, roughly?","options":[{"value":"lt5","label":"Under 5 kg"},{"value":"5to10","label":"5 to 10 kg"},{"value":"gt10","label":"More than 10 kg"},{"value":"inches","label":"Not about the scale, about how I look"}],"stage":"after_test"},{"id":"focus_areas","section":"goals","kind":"multi","when":{"q":"goal","in":["muscle","fat_loss","strength"