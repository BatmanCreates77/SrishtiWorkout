NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it

# Site password gate (required). Use a long passphrase; set it in Vercel, never commit it.
SITE_PASSWORD=
# Optional extra secret mixed into session signatures; change it to sign every device out.
SITE_SESSION_SECRET=

# Web push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Shared with the Supabase pg_cron job that calls /api/cron/notify
CRON_SECRET=
# Private app account the password gate signs into
APP_USER_EMAIL=
APP_USER_PASSWORD=
