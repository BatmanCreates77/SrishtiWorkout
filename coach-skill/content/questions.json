 "questions": [
  {
   "id": "intro",
   "section": "welcome",
   "kind": "info",
   "coach": "Hi, I'm Maya, your coach. A few quick questions, then a short movement check so I can build a plan around the real you. About 10 minutes, and the rest we can chat about later. You can tap an option or type your own answer anytime.",
   "stage": "essentials"
  },
  {
   "id": "name",
   "section": "you",
   "kind": "text",
   "field": "name",
   "required": true,
   "coach": "First, what should I call you?",
   "stage": "essentials"
  },
  {
   "id": "age",
   "section": "you",
   "kind": "number",
   "field": "age",
   "unit": "years",
   "min": 14,
   "max": 90,
   "required": true,
   "coach": "Nice to meet you, {name}! How old are you? I use it to compare your results with the right norms.",
   "stage": "essentials"
  },
  {
   "id": "sex",
   "section": "you",
   "kind": "single",
   "field": "sex",
   "required": true,
   "coach": "Which norms should I use for your fitness tests?",
   "options": [
    {
     "value": "female",
     "label": "Female"
    },
    {
     "value": "male",
     "label": "Male"
    }
   ],
   "stage": "essentials"
  },
  {
   "id": "height",
   "section": "you",
   "kind": "number",
   "field": "heightCm",
   "unit": "cm",
   "min": 120,
   "max": 220,
   "coach": "How tall are you? Height and weight let me compare your results fairly.",
   "stage": "essentials"
  },
  {
   "id": "weight",
   "section": "you",
   "kind": "number",
   "field": "weightKg",
   "unit": "kg",
   "min": 30,
   "max": 250,
   "step": 0.1,
   "coach": "And your current weight? It stays private and helps me read your results and set protein targets.",
   "stage": "essentials"
  },
  {
   "id": "parq",
   "section": "health",
   "kind": "multi",
   "field": "parq",
   "required": true,
   "coach": "Safety first. Do any of these apply to you?",
   "options": [
    {
     "value": "none",
     "label": "None of these",
     "exclusive": true
    },
    {
     "value": "heart",
     "label": "Heart condition or high blood pressure"
    },
    {
     "value": "chestPain",
     "label": "Chest pain at rest or when active"
    },
    {
     "value": "dizzy",
     "label": "Dizziness or fainting in the last year"
    },
    {
     "value": "chronic",
     "label": "Another chronic condition (e.g. diabetes, thyroid, PCOS)"
    },
    {
     "value": "meds",
     "label": "Prescribed medicine for a chronic condition"
    },
    {
     "value": "joint",
     "label": "A joint or bone problem that activity could worsen"
    },
    {
     "value": "supervised",
     "label": "A doctor said to exercise only under supervision"
    }
   ],
   "react": {
    "any_except:none": "Thanks for telling me. I'll keep things conservative, and please check with your doctor before the harder efforts."
   },
   "stage": "essentials"
  },
  {
   "id": "cleared",
   "section": "health",
   "kind": "single",
   "when": {
